<?xml version="1.0" encoding="utf-8"?>
<!-- 数据仅保存在本机：不参与云备份，也不在换机迁移时复制 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
