<?xml version="1.0" encoding="utf-8"?>
<!-- 记录详情（对话框内容）：时间和精确用时、动作数 · 组数、各动作组数；下面改部位和备注。内容多时可以滚动 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 在触摸模式下也能获得焦点：打开时焦点落在这里，不会先落到备注框上 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="?android:attr/dialogPreferredPadding"
        android:paddingTop="4dp"
        android:paddingEnd="?android:attr/dialogPreferredPadding"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/recordTime"
            style="@style/RecordLine" />

        <TextView
            android:id="@+id/recordSummary"
            style="@style/RecordLine"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/recordPerExercise"
            style="@style/RecordSub" />

        <TextView
            android:id="@+id/recordAuto"
            style="@style/RecordSub"
            android:text="@string/record_auto_ended" />

        <TextView
            style="@style/FieldLabel"
            android:layout_marginTop="20dp"
            android:text="@string/record_parts_label" />

        <LinearLayout
            android:id="@+id/parts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <TextView
            style="@style/FieldLabel"
            android:layout_marginTop="20dp"
            android:text="@string/record_note_label" />

        <EditText
            android:id="@+id/note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/record_note_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="100"
            android:maxLines="4"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
