<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 小号说明文字，加宽字距 -->
    <style name="Eyebrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Hint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 大号细体数字：等宽数字避免跳动 -->
    <style name="BigNumber">
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textFontWeight">200</item>
    </style>

    <!-- 未开始界面的组间休息数值：随系统字体大小自动适配 -->
    <style name="IdleValue" parent="BigNumber">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">128dp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">40sp</item>
        <item name="android:autoSizeMaxTextSize">104sp</item>
        <item name="android:autoSizeStepGranularity">2sp</item>
    </style>

    <!-- 圆环中的计时：字号由代码按圆环直径设置 -->
    <style name="TimerText" parent="BigNumber">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">72sp</item>
    </style>


    <style name="PhaseLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:accessibilityLiveRegion">polite</item>
        <item name="android:letterSpacing">0.3</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CounterValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">44sp</item>
    </style>

    <style name="RestValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="PillPrimary">
        <item name="android:layout_height">60dp</item>
        <item name="android:background">@drawable/bg_pill_primary</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/on_volt</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">17sp</item>
    </style>


    <style name="PillOutline" parent="PillPrimary">
        <item name="android:background">@drawable/bg_pill_outline</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="RoundButton">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@drawable/bg_round_button</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/round_button_text</item>
        <item name="android:textFontWeight">300</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="RoundButton.Small">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="IconToggle">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/icon_button_tint</item>
    </style>


    <style name="TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/bg_text_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
