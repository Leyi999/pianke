<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 小号说明文字，加宽字距 -->
    <style name="Eyebrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Hint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 大号细体数字：等宽数字避免跳动 -->
    <style name="BigNumber">
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textFontWeight">200</item>
    </style>

    <!-- 未开始界面的组间休息数值：随系统字体大小自动适配 -->
    <style name="IdleValue" parent="BigNumber">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">128dp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">40sp</item>
        <item name="android:autoSizeMaxTextSize">104sp</item>
        <item name="android:autoSizeStepGranularity">2sp</item>
    </style>

    <!-- 圆环中的计时：字号由代码按圆环直径设置 -->
    <style name="TimerText" parent="BigNumber">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">72sp</item>
    </style>


    <style name="PhaseLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:accessibilityLiveRegion">polite</item>
        <item name="android:letterSpacing">0.3</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CounterValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">44sp</item>
    </style>

    <style name="RestValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="PillPrimary">
        <item name="android:layout_height">60dp</item>
        <item name="android:background">@drawable/bg_pill_primary</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">17sp</item>
    </style>


    <style name="PillOutline" parent="PillPrimary">
        <item name="android:background">@drawable/bg_pill_outline</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="RoundButton">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@drawable/bg_round_button</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/round_button_text</item>
        <item name="android:textFontWeight">300</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="RoundButton.Small">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="IconToggle">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/icon_button_tint</item>
    </style>


    <style name="TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/bg_text_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- 二级页面（训练记录）顶栏标题 -->
    <style name="ScreenTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:accessibilityHeading">true</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- 训练记录的月份标题：字距比 Eyebrow 小，年月里的数字不会被拉散 -->
    <style name="HistoryMonth" parent="Eyebrow">
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- 训练记录卡片：左边几号 + 星期，右边动作数 · 组数、开始时间 · 用时 -->
    <style name="HistoryDay">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="HistoryWeekday">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="HistorySummary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="HistoryDetail">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 训练记录页顶部的月历 -->
    <style name="CalendarTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:accessibilityHeading">true</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- 星期和日期格子由代码生成（TextView 的 defStyleRes），这两个样式里不写 layout_* -->
    <style name="CalendarWeekday">
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CalendarDay">
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- 记录卡片上的备注：一行，放不下省略 -->
    <style name="HistoryNote" parent="HistoryDetail">
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- 训练部位芯片（CheckBox，由代码生成）：选中白底黑字，未选中细描边 -->
    <style name="PartChip" parent="@android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:background">@drawable/bg_part_chip</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/part_chip_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 对话框里的小标题（练了哪些部位、备注）；和 Eyebrow 不同，读屏会读 -->
    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 记录详情：时间、动作数 · 组数（主文字），各动作组数、自动结束说明（次要文字） -->
    <style name="RecordLine">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="RecordSub" parent="RecordLine">
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 未开始界面的最近训练：本周次数（主文字）+ 上次训练（次要文字） -->
    <style name="RecentWeek">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="RecentLast" parent="Hint">
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
